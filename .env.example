# Copy to .env and fill in. Do not commit .env, it holds your credentials.
#   cp .env.example .env && chmod 600 .env
#
# Values are read literally. Do not wrap them in quotes and do not put spaces
# around the "=", both Docker and systemd would treat those as part of the value.

# Required. See the README for how to capture the token and the pet id.
at_token=YGza5ertORghredgUOXAQw
at_petid=12345
ns_url=https://nightscout.example.com/
ns_api_secret=162f14de46149447c3338a8286223de407e3b2fa

# Optional. Defaults shown, delete any line to keep the default.
uploader_interval=30
uploader_max_entries=0
uploader_all_data=False
retries=10
timeout=10

# Correct a wrong meter clock. All three or none, off unless set. Read the README
# first. Fix the device clock BEFORE setting these, and record the drift before you
# reset it, since resetting destroys the only evidence of how far out it was.
#   minutes   signed, positive for a meter running slow
#   from      when the fault began, matched on the meter's own timestamp
#   fixed_at  when you corrected the device clock. Naive is UTC, or paste a local
#             time with its offset, which is harder to get wrong.
# at_clock_drift_minutes=488
# at_clock_drift_from=2026-03-21
# at_clock_drift_fixed_at=2026-08-10T21:00+10:00
