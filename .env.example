# Copy to .env and fill in. Do not commit .env, it holds your credentials.
#   cp .env.example .env && chmod 600 .env
#
# Values are read literally. Do not wrap them in quotes and do not put spaces
# around the "=", both Docker and systemd would treat those as part of the value.

# Required. See the README for how to capture the token and the pet id.
at_token=YGza5ertORghredgUOXAQw
at_petid=12345
ns_url=https://nightscout.example.com/
ns_api_secret=162f14de46149447c3338a8286223de407e3b2fa

# Optional. Defaults shown, delete any line to keep the default.
uploader_interval=30
uploader_max_entries=0
uploader_all_data=False
retries=10
timeout=10
